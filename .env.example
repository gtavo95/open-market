APP_NAME=demo-api
ENV=dev
DEBUG=false

# Default: okf/, the bundle of this repo. To try another one:
# BUNDLE_DIR=../other-bundle

PUBLIC_URL=

# muse, openai, gemini or anthropic. In prod the key does not go in a file: it is
# a secret mounted as env on the Cloud Run service.
PROVIDER=muse
MUSE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Empty means the ones in `core_agent.provider` (muse-wonder-1.0 with medium /
# gpt-6-luna with medium / gemini-3.8-flash with low). A name goes as is to the provider: it is the CLI's --model. THINKING is
# --effort.
MODEL=
THINKING=
RETRIES=4

SLOTS=2
# Seconds per turn, inside the loop; below the 120 s of knowledge's A2A client.
# With ORCHESTRATE it splits: half to the searcher, half to the writer.
TIMEOUT_S=90

# The sale gates are TypeSafe judgments (core_agent/gates.py): the
# key is required and the advisor does not start without it. In prod it is the secret
# PROD_TYPESAFE_API_KEY mounted as env, like the provider's.
TYPESAFE_API_KEY=

# CONTAINER runs the model's code in a child process (one spawn per
# query); on, because that is what makes the time cap really release the slot.
# It is the only agent lever left: the others (steps, window,
# the writer's REPL) are set by agro_v2.py as in the CLI.
CONTAINER=true
